# ── Google OAuth (вже налаштовано) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret

# ── Firebase (потрібно налаштувати для хмарної синхронізації) ─────────────────
# 1. Зайди на https://console.firebase.google.com
# 2. Створи новий проект (або використай існуючий)
# 3. Перейди до Project Settings → Service Accounts
# 4. Натисни "Generate new private key" — завантажиться JSON файл
# 5. Скопіюй значення з того JSON файлу сюди:

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Важливо: скопіюй private_key з JSON файлу (включаючи -----BEGIN PRIVATE KEY-----)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
